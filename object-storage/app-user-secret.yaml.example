# Credenciais do usuário do app no MinIO (policy cuidar-sigtap, só cuidar-storage/prd/* e cuidar-storage/saude/*).
#   cp app-user-secret.yaml.example app-user-secret.yaml
#   # troque a senha (>= 8 chars). Ex.: openssl rand -base64 24
#   kubectl apply -f app-user-secret.yaml
#
# NÃO versione app-user-secret.yaml com senha real.
# Os mesmos valores vão para o Secret minio-s3-credentials de cada tenant.
apiVersion: v1
kind: Secret
metadata:
  name: minio-app-user
  namespace: object-storage
  labels:
    app: minio
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: "cuidar-sigtap"
  AWS_SECRET_ACCESS_KEY: "CHANGE_ME_STRONG_PASSWORD"
