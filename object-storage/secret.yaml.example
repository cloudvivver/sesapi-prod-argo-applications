# Copie para secret.yaml, troque as senhas e aplique:
#   cp secret.yaml.example secret.yaml
#   # edite MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
#   kubectl apply -f secret.yaml
#
# NÃO versione secret.yaml com senhas reais.
#
# As mesmas keys devem ir para os tenants (ex. saude-homolog) como
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (ver minio-s3-credentials.secret.yaml.example).
apiVersion: v1
kind: Secret
metadata:
  name: minio-root
  namespace: object-storage
  labels:
    app: minio
type: Opaque
stringData:
  MINIO_ROOT_USER: "cuidarminio"
  # Gere senha forte (>= 8 chars). Ex.: openssl rand -base64 24
  MINIO_ROOT_PASSWORD: "CHANGE_ME_STRONG_PASSWORD"
