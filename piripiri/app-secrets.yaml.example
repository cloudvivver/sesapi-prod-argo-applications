apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: piripiri
  labels:
    app: piripiri
    environment: production
type: Opaque
stringData:
  # API Keys
  PI_CLIENT_SECRET: "SUBSTITUA_AQUI"
  X_API_KEY_CONNECT: "SUBSTITUA_AQUI"

  # Database Credentials (AWS RDS via Proxy)
  DATABASE_PASSWORD: "SUBSTITUA_AQUI"
  DATABASE_USERNAME: postgres

  # Rails Secret Key
  SECRET_KEY_BASE: "SUBSTITUA_AQUI"

  # API Tokens
  HIDRA_TOKEN: "SUBSTITUA_AQUI"

  # Monitoring
  SENTRY_URL: "https://SUBSTITUA_AQUI@sentry.bigdatasys.net/SUBSTITUA_AQUI"

# ====================================================================
# IMPORTANTE: NÃO COMMITAR ESTE ARQUIVO COM SENHAS REAIS!
# ====================================================================
#
# O Secret app-secrets já existe no namespace piripiri.
# Para recriar no cluster:
#   kubectl create secret generic app-secrets \
#     --from-literal=DATABASE_PASSWORD='...' \
#     --from-literal=DATABASE_USERNAME='postgres' \
#     --from-literal=SECRET_KEY_BASE='...' \
#     --from-literal=HIDRA_TOKEN='...' \
#     --from-literal=SENTRY_URL='...' \
    --from-literal=PI_CLIENT_SECRET='...' \
    --from-literal=X_API_KEY_CONNECT='...' \
    --namespace piripiri
# ====================================================================
