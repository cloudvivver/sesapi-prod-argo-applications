# Credenciais S3-compatible (MinIO) para SIGTAP/SIA no saude-homolog.
#
# 1) Copie e alinhe USER/PASSWORD com object-storage/secret.yaml:
#      cp minio-s3-credentials.secret.yaml.example minio-s3-credentials.secret.yaml
# 2) Aplique OU sele com kubeseal e junte ao fluxo de sealed-secrets:
#      kubectl apply -f minio-s3-credentials.secret.yaml
#
# NÃO versione o arquivo com senha real.
apiVersion: v1
kind: Secret
metadata:
  name: minio-s3-credentials
  namespace: saude-homolog
  labels:
    app: cuidar
    purpose: minio-sigtap
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: "cuidarminio"
  AWS_SECRET_ACCESS_KEY: "CHANGE_ME_STRONG_PASSWORD"
