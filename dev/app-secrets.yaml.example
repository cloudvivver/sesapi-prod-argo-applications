apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: dev
  labels:
    app: dev
    environment: production
type: Opaque
stringData:
  # Database Credentials (AWS RDS via Proxy)
  DATABASE_PASSWORD: "SUBSTITUA_AQUI"
  DATABASE_USERNAME: postgres

  # Rails Secret Key
  SECRET_KEY_BASE: "SUBSTITUA_AQUI"

  # API Tokens
  HIDRA_TOKEN: "SUBSTITUA_AQUI"

  # Monitoring
  SENTRY_URL: "https://SUBSTITUA_AQUI@sentry.bigdatasys.net/20"

# ====================================================================
# IMPORTANTE: NÃO COMMITAR ESTE ARQUIVO COM SENHAS REAIS!
# ====================================================================
#
# O Secret app-secrets já existe no namespace dev.
# Para recriar no cluster, use:
#   ./create-secrets.sh
#
# Ou crie manualmente com kubectl:
#   kubectl create secret generic app-secrets \
#     --from-literal=DATABASE_PASSWORD='...' \
#     --from-literal=DATABASE_USERNAME='postgres' \
#     --from-literal=SECRET_KEY_BASE='...' \
#     --from-literal=HIDRA_TOKEN='...' \
#     --from-literal=SENTRY_URL='...' \
#     --namespace dev
# ====================================================================
