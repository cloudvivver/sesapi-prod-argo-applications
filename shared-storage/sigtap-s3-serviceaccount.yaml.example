# Exemplo — aplicar por namespace (trocar metadata.namespace)
apiVersion: v1
kind: ServiceAccount
metadata:
  name: cuidar-sigtap-sa
  namespace: piripiri
  labels:
    app.kubernetes.io/name: cuidar
    app.kubernetes.io/component: sigtap-s3
  annotations:
    eks.amazonaws.com/role-arn: arn:aws:iam::961341521437:role/cuidar-sigtap-s3
---
# Patch nos Deployments web/sidekiq do mesmo namespace:
# spec.template.spec.serviceAccountName: cuidar-sigtap-sa
